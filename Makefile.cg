OS_TYPE = $(shell uname -s | \
  awk '{ split($$1,a,"_"); printf("%s", a[1]);  }')

# NO_GC=1: see pyc_c_runtime.h's PYC_NO_GC block -- the generated
# program's allocations become calloc so valgrind can see them. Leaks by
# construction; debugging only.
ifdef NO_GC
  CFLAGS += -DPYC_NO_GC=1
endif
CFLAGS += -DUSE_GC=1 -I$(CG_ROOT) -I$(CG_ROOT)/../ifa -I$(CG_ROOT)/ifa/common -I/usr/local/include/gc -I/usr/local/include -I/opt/homebrew/include -I/opt/homebrew/include/gc -g -Wno-deprecated

LIBS = -L/opt/homebrew/lib -L/usr/local/lib -lm -lgc -lpcre

ifeq ($(OS_TYPE),Linux)
  LIBS += -ldl -lrt
endif

CC = clang++
CFLAGS += -std=c++23
# pyc's object model IS blind casts between prefix-compatible structs: a
# shared method takes a generic receiver and reads it as the base's
# layout (ifa/issues/110), and clones of one class are distinct struct
# types. C++ strict aliasing says a store through `S*` cannot change a
# load through `B*`, so at -O2 clang hoisted `b.more()` out of
# `while b.more(): b.step()`, made the loop infinite and side-effect
# free, deleted it, and fell through into the next function
# (tests/method_override_field_offset.py). The LLVM backend emits no TBAA,
# so this gives the C backend the same memory model.
CFLAGS += -fno-strict-aliasing
# `x ** 2` is libm's pow() in CPython. With the builtin, clang rewrites
# pow(x, 2.0) as x*x, which is correctly rounded where glibc's pow is not:
# they differ on ~0.08% of inputs, and nbody's trajectory diverged from
# CPython's at -O2.
CFLAGS += -fno-builtin-pow

# pyc sets OPTIMIZE by default (--no-optimize clears it). -O2 matches the
# LLVM backend; -O3 measured no faster (brainfuck 26.1s vs 25.4s, yopyra
# 40.4s vs 41.9s, chaos 59.4s vs 59.6s).
ifdef OPTIMIZE
  CFLAGS += -O2
endif

ifdef DEBUG
  CFLAGS += -g
endif

all: $(CG_FILES)
	@$(CC) $(CFLAGS) $(LDFLAGS) -o $(CG_TARGET) $(CG_FILES) $(CG_ROOT)/pyc_runtime.o $(CG_ROOT)/ifa/libifa_gc.a $(LIBS)
